# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Type checkers / linters
.mypy_cache/
.pyright/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# --- Secrets / local config ----------------------------------------------
# API keys (Google Maps, LLM providers, ...) live here — never commit them
.env
.env.*
!.env.example

# --- JetBrains (PyCharm) -------------------------------------------------
# Whole folder ignored: project settings are reproducible from pyproject.toml
.idea/
*.iml
out/

# --- OS / editors --------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.vscode/

# Note: uv.lock is intentionally NOT ignored — commit it for reproducible installs.
